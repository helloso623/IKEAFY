# Copy to .env locally. Never commit real keys.
# Lab bench generation (add a table, put four legs, generate a lamp) uses this
# hosted path when set. Leave empty to keep the built-in local steward.
OPENAI_API_KEY=
OPENAI_MODEL_HARD=gpt-4.1
OPENAI_MODEL_EASY=gpt-4.1-mini

# Pioneer by Fastino — preferred GLiNER 2 path (cloud API, no Hugging Face download).
# Get a key at https://gliner.pioneer.ai
# Optional alias: GLINER2_API_KEY. Force local weights with GLINER2_MODE=local.
PIONEER_API_KEY=
# GLINER2_MODE=auto
# GLINER2_API_BASE_URL=
# If api.fastino.ai TLS fails (CERTIFICATE_VERIFY_FAILED / expired CA), point at
# the venv certifi bundle after `npm run setup:gliner2`, then restart IKEAlive:
# SSL_CERT_FILE=/absolute/path/to/.venv-gliner2/.../site-packages/certifi/cacert.pem
# REQUESTS_CA_BUNDLE=  (same path; optional)
# Do not disable SSL verification.
# fal.ai key for drawing-only PDF plate vision and optional hosted instruction renders.
# Text-rich PDFs still use Pioneer/Fastino GLiNER 2 without this key.
# https://fal.ai/models/openrouter/router/vision/api
# https://fal.ai/models/bytedance/seedance-2.5/text-to-video
FAL_KEY=

# Optional: only for GLINER2_MODE=local when the checkpoint is not cached yet.
# Prefer PIONEER_API_KEY instead of Hugging Face Hub downloads.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Optional: Tavily key to look up official IKEA instruction PDFs from a product
# name, and live IKEA / Amazon / hardware links for tools that are not in the box.
# Leave empty to keep catalog stand-ins.
# https://docs.tavily.com
TAVILY_API_KEY=

PORT=8787
CLIENT_PORT=5173
