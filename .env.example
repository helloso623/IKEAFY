# Copy to .env locally. Never commit real keys.
# Lab bench generation (add a table, put four legs, generate a lamp) uses this
# hosted path when set. Leave empty to keep the built-in local steward.
OPENAI_API_KEY=
OPENAI_MODEL_HARD=gpt-4.1
OPENAI_MODEL_EASY=gpt-4.1-mini

# Optional: fal.ai key for ByteDance Seedance 2.5 step-film renders in the IKEAFY studio.
# Leave empty — the app works fully locally with the canvas storyboard instead.
# https://fal.ai/models/bytedance/seedance-2.5/text-to-video
FAL_KEY=

# Optional: Tavily key to look up official IKEA instruction PDFs from a product
# name, and live IKEA / Amazon / hardware links for tools that are not in the box.
# Leave empty to keep catalog stand-ins.
# https://docs.tavily.com
TAVILY_API_KEY=

PORT=8787
CLIENT_PORT=5173
