# Copy to .env locally. Never commit real keys.
# The workshop runs without this using the built-in local steward.
OPENAI_API_KEY=
OPENAI_MODEL_HARD=gpt-4.1
OPENAI_MODEL_EASY=gpt-4.1-mini

# Optional: fal.ai key for Veed Fabric 1.0 step-film renders in the IKEAFY studio.
# Leave empty — the app works fully locally with the canvas storyboard instead.
FAL_KEY=

PORT=8787
CLIENT_PORT=5173
